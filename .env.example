# Supabase project used for account + sync (one project for the whole app, set at build time; never entered per user).
# Supabase dashboard > Project Settings > API. Use the *anon / public* key ONLY - never the service_role or secret key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: https address where this app is hosted (for example your tailscale serve / domain URL, no trailing slash).
# The "sign in with your phone" QR code points the phone here. A TV app installed from the .ipk has no web address of its own.
VITE_PUBLIC_APP_URL=https://leen.example.com

# Tool-only secret for `pnpm db:push` (creates the sync tables). Not VITE_-prefixed, so it never
# reaches the client bundle. Supabase > Project Settings > Database > Connection string: use the
# direct or session-pooler URI, not the transaction one on :6543.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[ref].supabase.co:5432/postgres
